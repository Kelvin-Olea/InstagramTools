<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Redaction+10:ital,wght@0,400;0,700;1,400&family=Kanchenjunga:wght@400;500;600;700&family=Redaction+50:ital,wght@0,400;0,700;1,400&family=Redaction+35:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">

</head>
<body>

  <div id="app">
    <header>
      <div class="aperture" aria-hidden="true">
        <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor">
          <circle cx="40" cy="40" r="30" stroke-width="4" opacity="1"/>
          <line x1="40" y1="0" x2="40" y2="80" stroke-width="4" opacity="1"/>
          <line x1="40" y1="40" x2="68.284" y2="68.284" stroke-width="4" opacity="1"/>
          <line x1="40" y1="40" x2="68.284" y2="11.716" stroke-width="4" opacity="1"/>
          <circle cx="40" cy="40" r="39" stroke-width="1" opacity="1"/>
        </svg>
      </div>
      <h1>instagram<br>tools</h1>
      <p class="tagline">Tools used to easily sort through users following/followers lists</p>
    </header>

    <main class="container">

      <!-- Search -->
      <section class="search-section">
        <div class="section-label">TARGET PROFILES</div>

        <!-- Tab buttons -->
        <div class="tabs" role="tablist" aria-label="Scan type">
          <button type="button" class="tab" role="tab" id="tab-friends"
                  aria-selected="true" aria-controls="panel-friends">
            Friends
          </button>
          <button type="button" class="tab" role="tab" id="tab-filter"
                  aria-selected="false" aria-controls="panel-filter">
            Filter
          </button>
          <button type="button" class="tab" role="tab" id="tab-map"
                  aria-selected="false" aria-controls="panel-map">
            Map
          </button>

        </div>

        <!-- TAB 1: single profile -->
        <div class="input-group tab-panel" id="panel-friends" role="tabpanel" aria-labelledby="tab-friends">
          <p class="tab-hint" style="--i: 0">Scan a single profile.</p>
          <div class="usernames-container">
            <div class="input-row">
              <span class="input-num" style="--i: 1">01</span>
              <input type="text" class="username-input" placeholder="username"
                     autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" style="--i: 2"/>
            </div>
          </div>
          <div class="btn-row">
            <button type="button" class="btn btn-primary scan-btn" data-mode="friends" style="--i: 3">
              Run Scan
            </button>
          </div>
        </div>

        <!-- TAB 2: filter cached lists -->
        <div class="input-group tab-panel" id="panel-filter" role="tabpanel" aria-labelledby="tab-filter" hidden>
          <p class="tab-hint" style="--i: 0">Filter through lists of followers you have cached.</p>
            <div class="lists-container">
            <div class="input-row" >
              <span class="input-num" style="--i: 1">PRIMARY</span>
              <input type="text" class="username-input" placeholder="username"
                     autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" style="--i: 2"/>
              <span class="type-dropdown-container" style="--i: 2">
                <select name="followerOrFollowing" class="filter">
                  <option value="" disabled selected hidden>Select</option>
                  <option value="friends">Friends</option>
                  <option value="followers">Followers</option>
                  <option value="following">Following</option>
                </select>
              </span>
            </div>
            <div class="input-row">
              <span class="input-num" style="--i: 3">01</span>
              <input type="text" class="username-input" placeholder="username"
                      autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" style="--i: 4"/>
              <span class="type-dropdown-container" style="--i: 5">
                <select name="followerOrFollowing" class="filter" id="boolean-filter">
                  <option value="" disabled selected hidden>Select</option>
                  <option value="and">AND</option>
                  <option value="not">NOT</option>
                </select>
              </span>
              <span class="type-dropdown-container" style="--i: 6">
                <select name="followerOrFollowing" class="filter">
                  <option value="" disabled selected hidden>Select</option>
                  <option value="friends">Friends</option>
                  <option value="followers">Followers</option>
                  <option value="following">Following</option>
                </select>
              </span>
            </div>
          </div>
          <div class="btn-row">
            <button type="button" class="btn btn-primary scan-btn" data-mode="mutual" style="--i: 7">
              Run Scan
            </button>
          </div>
        </div>

        <!-- TAB 3: follower map -->
        <div class="input-group tab-panel" id="panel-map" role="tabpanel" aria-labelledby="tab-map" hidden>
          <p class="tab-hint" style="--i: 0">Generate a map of currently cached users.</p>
          <div class="map" id="map-results" style="--i: 1"></div>          
          <div class="btn-row">
            <button type="button" class="btn btn-primary map-btn" data-mode="map" style="--i: 2">
              Generate Map
            </button>
          </div>
        </div>

      </section>
      <!-- RESULTS -->
      <section id="results-section" class="results-section" style="display: none;">
        <div class="results-header">
          <div>
            <div class="section-label">SCAN COMPLETE</div>
            <h2 class="results-title">Intelligence Report</h2>
          </div>
          <button id="clear-btn" class="btn btn-ghost">New Scan</button>
        </div>

        <div class="stats">
          <div class="stat-box">
            <span class="stat-label">Profiles Scanned</span>
            <span id="accounts-count" class="stat-value">0</span>
          </div>
          <div class="stat-box stat-accent">
            <span class="stat-label">Mutual Followers</span>
            <span id="mutual-count" class="stat-value">0</span>
          </div>
        </div>

        <div id="followers-list" class="followers-list"></div>
      </section>

      <!-- LOADING -->
      <section id="loading-section" class="loading-section" style="display: none;">
        <div class="loader-ring" aria-hidden="true">
          <div class="loader-inner"></div>
        </div>
        <p class="loading-text">Scanning profiles<span class="blink-dots"></span></p>
        <p class="loading-sub">Time Estimate: <span id="time-estimate">calculating...</span></p>
      </section>

      <!-- ERROR -->
      <section id="error-section" class="error-section" style="display: none;">
        <div class="error-head">
          <span class="error-flag" aria-hidden="true">!</span>
          <div>
            <h3>Scan Failed</h3>
            <p id="error-message">An unexpected error occurred.</p>
          </div>
        </div>
        <div class="error-tips">
          <p class="section-label">TROUBLESHOOTING</p>
          <ul>
            <li>Verify usernames are spelled correctly</li>
            <li>Accounts must be public — private accounts cannot be scanned</li>
            <li>Instagram may be rate-limiting — wait a minute and retry</li>
            <li>Your session ID may have expired; update <code>INSTAGRAM_SESSION_ID</code> in <code>.env</code></li>
          </ul>
        </div>
      </section>
    </main>

    <footer>
      <p>Not affiliated with or endorsed by Instagram or Meta.</p>
      <p>Builty by Kelvin Olea, 2026.</p>    
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
  <script>
    const filterContainer = document.getElementById('lists-container');
    const addUsernameBtn  = document.getElementById('add-username-btn');
    const clearBtn        = document.getElementById('clear-btn');
    const loadingSection  = document.getElementById('loading-section');
    const resultsSection  = document.getElementById('results-section');
    const errorSection    = document.getElementById('error-section');
    const followersList   = document.getElementById('followers-list');

    const tabs   = Array.from(document.querySelectorAll('.tab'));
    const panels = Array.from(document.querySelectorAll('.tab-panel'));

    let inputCount = 2; // rows currently in the Mutual Followers tab

    // Switch the current tab to {tab} //
    function activateTab(tab) {

      tabs.forEach(t => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
      });

      // Hide any panel that isn't connected to the current selected tab button
      panels.forEach(p => { p.hidden = p.id !== tab.getAttribute('aria-controls'); });

      // Delete all old results and stuff
      resultsSection.style.display = 'none';
      errorSection.style.display   = 'none';
      loadingSection.style.display = 'none';
    }

    function formatDuration(totalSeconds) {
      const s = Math.max(0, Math.round(totalSeconds));
      const m = Math.floor(s / 60);
      const sec = s % 60;
      if (m === 0) return `${sec}s`;
      return `${m}m ${sec.toString().padStart(2, '0')}s`;
    }

    function showEstimate(seconds) {
      document.getElementById('time-estimate').textContent = `~${formatDuration(seconds)}`;
    }

    let countdownTimer = null;

    function startCountdown(seconds) {
        clearInterval(countdownTimer);
        const el = document.getElementById('time-estimate');
        const endTime = Date.now() + seconds * 1000;

        const tick = () => {
            const remaining = (endTime - Date.now()) / 1000;
            if (remaining <= 0) {
                el.textContent = 'almost done...';
                clearInterval(countdownTimer);
                return;
            }
            el.textContent = `~${formatDuration(remaining)}`;
        };

        tick();
        countdownTimer = setInterval(tick, 1000);
    }

    function stopCountdown() {
        clearInterval(countdownTimer);
    }

    // Add a listener to each tab button
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    // Run the scan //
    document.querySelectorAll('.scan-btn').forEach(btn => {
      btn.addEventListener('click', async () => { // Listen for clicks on scan buttons (for all tabs)
        btn.disabled = true;
        btn.textContent = "Scanning...";

        const mode  = btn.dataset.mode; // Gets the mode (friend or mutual)
        const panel = btn.closest('.tab-panel'); // Finds what tab we're in (for grabbing those users)

        const usernames = Array.from(panel.querySelectorAll('.username-input')) // Creates a list of all input usernames
          .map(i => i.value.trim())

        if (usernames.length < 1 || usernames.some(u => !u)) return showError('Please fill in every username.');

        if (mode === 'friends') return fetchFriends(usernames);

        const filters = Array.from(panel.querySelectorAll('.filter')) // Creates an organized list of all selected filters
          .filter(element => element.id !== "boolean-filter")
          .map(filter => filter.value.trim());
        
        if (filters.length !== usernames.length || filters.some(f => !f)) return showError('Please select a filter for every row.');

        const filterUsernames = usernames.map((username, i) => [username, filters[i]]);
        const booleanOperator = panel.querySelector('#boolean-filter').value

        if (filterUsernames.length < 2) return showError('Please enter at least 2 usernames.');

        return filterLists(filterUsernames, booleanOperator);
      });
    });

    // Clear the output //
    clearBtn.addEventListener('click', () => {
      resultsSection.style.display = 'none';
      errorSection.style.display   = 'none';
      loadingSection.style.display = 'none';
    });

    // Fetches mutual followers through custom API using input usernames //
    async function filterLists(filterUsernames, booleanOperator) {
      /* 
      filterusernames = [
        ["Username", "FilterList"]
      ]
      */
      try {
        resultsSection.style.display = 'none';
        errorSection.style.display   = 'none';
        loadingSection.style.display = 'flex';

        const res  = await fetch('/api/filter-lists', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ filterUsernames, booleanOperator })
        });

        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'Failed to filter lists');

        loadingSection.style.display = 'none';
        displayResults(data);
        resultsSection.style.display = 'block';
      } catch (err) {
        loadingSection.style.display = 'none';
        showError(err.message);
      } finally {
        document.querySelectorAll('.scan-btn').forEach(btn => {
          btn.disabled = false;
          btn.textContent = "Run Scan"
        })
      }
    }

    // Fetches friends through custom API using input username //
    async function fetchFriends(username) {
      try {
        resultsSection.style.display = 'none';
        errorSection.style.display   = 'none';
        loadingSection.style.display = 'flex';
        document.getElementById('time-estimate').textContent = 'calculating...';

        const resEstimate = await fetch('/api/friends/estimate', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ username })
        });
        const estimateData = await resEstimate.json();

        if (resEstimate.ok && estimateData.estimatedSeconds != null) {
          startCountdown(estimateData.estimatedSeconds);
        }

        const res  = await fetch('/api/friends', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ username })
        });
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'Failed to fetch friends');

        stopCountdown();
        loadingSection.style.display = 'none';
        displayResults(data);
        resultsSection.style.display = 'block';
      } catch (err) {
        stopCountdown();
        loadingSection.style.display = 'none';
        showError(err.message);
      } finally {
        document.querySelectorAll('.scan-btn').forEach(btn => {
          btn.disabled = false;
          btn.textContent = "Run Scan";
        });
      }
    }
    /* ---------- Rendering ---------- */

    function displayResults(data) {

      if (typeof data.usernames == "string"){
        document.getElementById('accounts-count').textContent = 1;
      } else{
        document.getElementById('accounts-count').textContent = data.usernames.length;
      }

      document.getElementById('mutual-count').textContent = data.count;

      followersList.innerHTML = '';

      if (!data.usersList.length) {
        followersList.innerHTML = '<p class="no-results">No mutual followers found across these accounts.</p>';
        return;
      }

      data.usersList.forEach((follower, i) => {
        const card = document.createElement('div');
        card.className = 'follower-card';
        card.style.animationDelay = `${i * 35}ms`;
        const fallback = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 60'><rect fill='%23201c17' width='60' height='60'/><text x='30' y='38' text-anchor='middle' fill='%235a4e3d' font-size='22' font-family='serif'>?</text></svg>`;
        card.innerHTML = `
          <div class="photo-print">
            <img src="/pfp?url=${encodeURIComponent(follower.profile_pic_url)}" alt="${follower.username}"
                 class="follower-avatar" onerror="this.src='${fallback}'"/>
          </div>
          <div class="follower-meta">
            <p class="follower-username">@${follower.username}</p>
            <p class="follower-name">${follower.full_name || '—'}</p>
          </div>
        `;
        followersList.appendChild(card);
      });
    }

    function showError(msg) {
      loadingSection.style.display = 'none';
      resultsSection.style.display = 'none';
      errorSection.style.display   = 'block';
      document.getElementById('error-message').textContent = msg;
    }

    /* ---------- Generate The Map ---------- */
    function renderGraph(data) {
      const container = document.getElementById('map-results');
      container.innerHTML = '';

      const width = container.clientWidth;
      const height = container.clientHeight;

      const nodePower = 1/1.8

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', [0, 0, width, height]);

      const g = svg.append('g');

      // Add a lister to the svg to detect mouse zoom + pan
      svg.call(d3.zoom()
        .scaleExtent([0.2, 8])
        .on('zoom', e => {
          g.attr('transform', e.transform);
        }));

      // Simulate the forces acting on the nodes
      const simulation = d3.forceSimulation(data.nodes)
        .force('link', d3.forceLink(data.links).id(d => d.id).distance(7))
        .force('charge', d3.forceManyBody().strength(-30))
        .force('x', d3.forceX(width / 2).strength(0.4))
        .force('y', d3.forceY(height / 2).strength(0.4))        
        .force('collide', d3.forceCollide(d => 1 + Math.pow(d.totalLinks, nodePower) * 1 + 1));

      const defs = svg.append('defs');

      defs.selectAll('pattern')
        .data(data.nodes)
        .join('pattern')
        .attr('id', (d, i) => `pfp-${i}`)
        .attr('patternContentUnits', 'objectBoundingBox')
        .attr('width', 1)
        .attr('height', 1)
        .append('image')
        .attr('width', 1)
        .attr('height', 1)
        .attr('preserveAspectRatio', 'xMidYMid slice')
        .attr('href', d => d.pic ? `/pfp?url=${encodeURIComponent(d.pic)}` : null);

      // Create all the links between the nodes
      const link = g.append('g')
        .attr('stroke', 'rgba(255,255,255,0.25)')
        .selectAll('line')
        .data(data.links)
        .join('line');

      // Create all the nodes
      const node = g.append('g')
        .selectAll('circle')
        .data(data.nodes)
        .join('circle')
        .attr('r', d => 1 + Math.pow(d.totalLinks, nodePower) * 1)        
        .attr('fill', (d, i) => d.pic ? `url(#pfp-${i})` : '#6b7280')      
        .attr('stroke', d => d.scanned ? '#8b5cf6' : 'rgba(255,255,255,0.3)')
        .attr('stroke-width', d => d.scanned ? 2 : 0.5)  
        .call(drag(simulation));

      node.append('title').text(d => d.id);   // hover tooltip

      const label = g.append('g')
        .selectAll('text')
        .data(data.nodes)
        .join('text')
        .text(d => d.id)
        .attr('font-size', d => Math.pow(d.totalLinks, nodePower) * 1)
        .attr('fill', '#ccc')
        .attr('dx', 10)
        .attr('dy', 3);

      simulation.on('tick', () => {
        link
          .attr('x1', d => d.source.x).attr('y1', d => d.source.y)
          .attr('x2', d => d.target.x).attr('y2', d => d.target.y);
        node.attr('cx', d => d.x).attr('cy', d => d.y);
        label.attr('x', d => d.x).attr('y', d => d.y);
      });
    }

    function drag(simulation) {
      return d3.drag()
        .on('start', (e, d) => {
          if (!e.active) simulation.alphaTarget(0.3).restart();
          d.fx = d.x; d.fy = d.y;
        })
        .on('drag', (e, d) => { d.fx = e.x; d.fy = e.y; })
        .on('end', (e, d) => {
          if (!e.active) simulation.alphaTarget(0);
          d.fx = null; d.fy = null;
        });
    }

    document.querySelector('.map-btn').addEventListener('click', async () => {
      const res = await fetch('/api/map');
      const data = await res.json();
      renderGraph(data);
    });

  </script>
</body>
</html>